# GitHub Personal Access Token (classic or fine-grained)
# If omitted, Contrib will operate unauthenticated with lower rate limits (60 req/hr).
# With a token, rate limits are 5,000 req/hr.
GITHUB_TOKEN=

# Cache configuration in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Backend server host and port
HOST=127.0.0.1
PORT=8000

# Database connection URL
# For PostgreSQL (local or cloud like Render / Supabase / Neon):
# DATABASE_URL=postgresql://username:password@localhost:5432/contribo
# If DATABASE_URL is omitted, Contrib falls back to local SQLite (contrib_cache.db)
DATABASE_URL=

# SQLite fallback path (used only if DATABASE_URL is not set)
DATABASE_PATH=contrib_cache.db

# Qwen Inference Configuration
HF_TOKEN=
QWEN_MODEL=Qwen/Qwen3.8-27B:novita
QWEN_BASE_URL=https://router.huggingface.co/v1



