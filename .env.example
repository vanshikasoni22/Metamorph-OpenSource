# GitHub Personal Access Token (classic or fine-grained)
# If omitted, Contrib will operate unauthenticated with lower rate limits (60 req/hr).
# With a token, rate limits are 5,000 req/hr.
GITHUB_TOKEN=

# Cache configuration in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Backend server host and port
HOST=127.0.0.1
PORT=8000

# SQLite database file path
DATABASE_PATH=contrib_cache.db
