{
  "version": 2,
  "buildCommand": "node scripts/inject-api-url.js",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/beginner", "destination": "/beginner.html" },
    { "source": "/mentor", "destination": "/mentor.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.(js|css))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "env": {
    "CONTRIB_API_URL": "https://contribo.onrender.com"
  }
}
